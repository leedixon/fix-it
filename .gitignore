# Secrets — never commit real credentials
config/config.php
.env

# Runtime
storage/uploads/*
!storage/uploads/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/cache/*

# The maintenance switch. Per-server state, never per-repository: committing it
# would mean a git pull could take a site down, or bring one up mid-migration.
storage/maintenance.json

# Local
.DS_Store
*.log
node_modules/
vendor/
